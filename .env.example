# ==============================================================================
# VIP TADJ — Haute Élégance Masculine
# Master Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development or configure these variables
# directly in your hosting provider's dashboard (e.g., Vercel Project Settings).
#
# Classification:
# - PUBLIC: Prefixed with NEXT_PUBLIC_, embedded into client JavaScript bundles.
# - PRIVATE: Server-side only, never leaked to the client browser.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
# Defines the operational environment and canonical deployment domain.
NODE_ENV="production"

# Canonical production URL of the deployed storefront (used for metadata, OpenGraph, sitemaps)
# Format: https://yourdomain.com (no trailing slash)
NEXT_PUBLIC_APP_URL="https://www.viptadj.dz"

# Storefront display name
NEXT_PUBLIC_SITE_NAME="VIP TADJ — Haute Élégance Masculine"

# ------------------------------------------------------------------------------
# 2. FIREBASE & CLOUD FIRESTORE CONFIGURATION (CLIENT & SERVER)
# ------------------------------------------------------------------------------
# Web Client SDK credentials obtained from:
# Firebase Console -> Project Settings -> General -> "Your apps" -> Web app configuration.
#
# NOTE: In local development, if NEXT_PUBLIC_FIREBASE_API_KEY or NEXT_PUBLIC_FIREBASE_PROJECT_ID
# are omitted or set to dummy strings, VIP TADJ automatically activates its resilient
# zero-config MockSeedDataProvider. For production multi-user persistence, all Firebase
# variables below must be properly populated.

# Firebase Web API Key (Public client token for authenticating to Firebase services)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyA1B2C3D4E5F6G7H8I9J0K1L2M3N4O5P6Q"

# Firebase Auth domain (handles auth redirects and token exchanges)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="vip-tadj-prod.firebaseapp.com"

# Google Cloud / Firebase Project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID="vip-tadj-prod"

# Google Cloud Storage bucket (default bucket for Firebase Cloud Storage)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="vip-tadj-prod.appspot.com"

# Firebase Cloud Messaging (FCM) Sender ID (numeric project identifier)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"

# Firebase Web Application ID (unique identifier for this web client registered in project)
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef0123456789abcdef"

# Google Analytics 4 Measurement ID (optional, tracks storefront telemetry if enabled)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ------------------------------------------------------------------------------
# 3. CLOUDINARY MEDIA UPLOAD STORAGE (CLIENT & SERVER)
# ------------------------------------------------------------------------------
# VIP TADJ utilizes direct client-side unsigned uploads to Cloudinary to bypass
# serverless file size and execution limits.
#
# Configuration steps:
# 1. Sign up at https://cloudinary.com
# 2. In Cloudinary Console -> Settings -> Upload -> Upload presets -> Add upload preset
# 3. Set Signing Mode: "Unsigned", Name: "viptadj_unsigned_products"
# 4. Set Folder: "vip-tadj/products", Allowed Formats: "jpg,jpeg,png,webp", Max File Size: "10000000"
#
# Client-side variables (required for Admin catalog manager direct uploads):
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="viptadj"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="viptadj_unsigned_products"

# Server-side fallback variables (used by /api/media/upload fallback proxy route):
CLOUDINARY_CLOUD_NAME="viptadj"
CLOUDINARY_UPLOAD_PRESET="viptadj_unsigned_products"

# ------------------------------------------------------------------------------
# 4. DATABASE SEEDING & ADMINISTRATIVE API SECURITY (PRIVATE — SERVER ONLY)
# ------------------------------------------------------------------------------
# Secret key protecting the catalog initialization endpoint (/api/seed).
# In production, /api/seed strictly rejects requests unless authenticated with this token
# via the 'x-seed-secret' HTTP header or '?secret=' URL query parameter.
#
# Generate a cryptographically random 32+ character string (e.g. via `openssl rand -hex 32`):
SEED_SECRET="vt_prod_seed_sec_994821a7c3f8e02d41b59a6e138f07c2"

# ------------------------------------------------------------------------------
# 5. ALGERIAN STOREFRONT CONTACT & WHATSAPP CONCIERGE (PUBLIC)
# ------------------------------------------------------------------------------
# Official customer service telephone and WhatsApp numbers displayed on the storefront
# and used by the automated WhatsApp order confirmation link generator.

# Customer support phone number formatted for national Algerian dialing (05/06/07)
NEXT_PUBLIC_STORE_PHONE="0550123456"

# Customer support WhatsApp number with international Algerian prefix 213 (no + or leading 0)
NEXT_PUBLIC_STORE_WHATSAPP="213550123456"
